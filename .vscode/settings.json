{
  "cmake.generator": "Unix Makefiles",
  "cmake.configureEnvironment": {
    "CMAKE_EXPORT_COMPILE_COMMANDS": "on"
  },
  "C_Cpp.default.intelliSenseMode": "gcc-arm",
  "files.associations": {
    "*.yrf": "json",
    "*.rpx": "xml",
    "*.stl": "json",
    "stm32f4xx_hal.h": "c",
    "stm32f4xx.h": "c",
    "stdint.h": "c"
  },
  "cortex-debug.gdbPath": "arm-none-eabi-gdb"
}
